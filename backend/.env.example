# App
APP_NAME=SnapTogether
APP_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production

# CORS - Frontend origin
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://yourusername.github.io

# Storage (choose one)
STORAGE_BACKEND=local  # "local" or "s3"

# Local storage (dev only)
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (production)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_BUCKET_NAME=snaptogether-uploads
AWS_REGION=us-east-1
AWS_CLOUDFRONT_URL=https://your-cf-domain.cloudfront.net

# Redis (for room state)
REDIS_URL=redis://localhost:6379
# For Render Redis: redis://red-xxxx:6379

# Stable Horde (free AI generation — https://stablehorde.net)
# Leave as "0000000000" to use anonymously (works but slower queue)
# Get a FREE key at https://stablehorde.net/register for better priority
STABLE_HORDE_API_KEY=0000000000
